{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "halka-arz-portfoy-news-test",
  "main": "cloudflare/news-worker.js",
  "compatibility_date": "2026-09-17",
  "durable_objects": {
    "bindings": [
      {
        "name": "NEWS_STATE",
        "class_name": "NewsStateDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NewsStateDurableObject"]
    }
  ]
}

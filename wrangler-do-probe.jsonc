{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "halka-arz-portfoy-do-probe",
  "main": "cloudflare/do-probe.js",
  "compatibility_date": "2026-09-14",
  "durable_objects": {
    "bindings": [
      {
        "name": "PROBE",
        "class_name": "ProbeState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ProbeState"]
    }
  ]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "halka-arz-portfoy-push",
  "keep_vars": true,
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-14",
  "durable_objects": {
    "bindings": [
      {
        "name": "PUSH_STATE",
        "class_name": "PushStateDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PushStateDurableObject"]
    }
  ]
}
